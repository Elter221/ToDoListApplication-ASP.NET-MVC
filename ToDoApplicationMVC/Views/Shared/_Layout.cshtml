<!DOCTYPE html>
<html>
    <head>
        <title>WebPage</title>
        <link href="~/styles/app.css" rel="stylesheet" />
    </head>
    <body>
        <menu>
            <a asp-controller="Home" asp-action="Index">To-Do Lists</a>
            <a asp-controller="ToDo" asp-action="Index" asp-route-userId="@(1 as int?)">Your To-Dos</a>
            <a asp-controller="Tag" asp-action="View">Tags</a>

            @if (User.IsInRole("Admin"))
            {
                <li>
                    <form asp-controller="User" asp-action="AssignNewEditor" method="post"
                          style="display: flex; gap: 10px; align-items: center;"
                          onsubmit="return confirm('Assign Editor role to ' + this.email.value + '?')">
                        <input type="email"
                               name="email"
                               placeholder="User email"
                               style="padding: 8px 12px; border: 2px solid #e0e0e0; border-radius: 4px;"
                               required>
                        <button type="submit" class="admin-button">
                            Make Editor
                        </button>
                    </form>
                </li>
            }

            <ul>
                @if (SignInManager.IsSignedIn(User))
                {
                    <li>
                        <span>Hello @User.Identity!.Name</span>
                    </li>
                    <li>
                        <form asp-controller="User" asp-action="Logout" method="post">
                            <button type="submit">Logout</button>
                        </form>
                    </li>
                }
                else
                {
                    <li>
                        <a asp-controller="User" asp-action="Register">Register</a>
                    </li>
                    <li>
                        <a asp-controller="User" asp-action="Login">Login</a>
                    </li>
                }
            </ul>
        </menu>
        <div class="body">
            <div>
            @(await RenderSectionAsync("PageHeader", true))
            </div>
            @RenderBody()
        </div>
        <footer>
            Made by Dudik Vladislav!
        </footer>

    @(await RenderSectionAsync("Scripts", required: false))
    </body>
</html>